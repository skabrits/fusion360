# Web login
FUSION_PASSWORD=CHANGE_ME
WEB_PORT=3081
BIND_ADDRESS=0.0.0.0
PUID=1000
PGID=1000

# Docker-build proxy only. Leave blank for direct builds.
BUILD_PROXY=

# Runtime Autodesk proxy. Supported: http, https, socks5. Leave blank for direct.
FUSION_PROXY_URL=

# Optional existing named /config volume. Leave default unless upgrading an existing deployment.
FUSION_VOLUME=fusion360_config

# Optional build controls
BASE_IMAGE=lscr.io/linuxserver/webtop:ubuntu-xfce
WINE_PACKAGE_VERSION=11.18~resolute-1
WINE_SOURCE_VERSION=11.18
WINE_STAGING_VERSION=11.18
WINE_BUILD_JOBS=4
FUSION_SEED_REV=1

# Runtime resource/feature controls
FUSION_MEMORY_LIMIT=8g
SLICERS_USE_PROXY=0
SLICERS_SOFTWARE_RENDERING=0
# Inside-container path to an optional mounted PEM CA bundle for Bambuddy/printer TLS.
BAMBUDDY_CERT_FILE=

# Fusion/X11 compatibility controls. Defaults below are the release policy.
FUSION_WINDOW_MANAGED=Y
FUSION_UNMANAGE_OWNED_WINDOWS=N
FUSION_WINDOW_POLICY=Y
FUSION_WINDOW_DECORATED=Y
FUSION_USE_TAKE_FOCUS=N
FUSION_UI_API=OpenGL
FUSION_WEBVIEW2_DISABLE_GPU=0
FUSION_WEBVIEW2_NO_SANDBOX=1
FUSION_QTWEBENGINE_DISABLE_GPU=0
FUSION_QTWEBENGINE_NO_SANDBOX=0
FUSION_WEBVIEW2_WINVER=win8
